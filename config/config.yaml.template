# ============================================
# A股量化选股系统 - 主配置文件模板
# ============================================
# 使用说明：
# 1. 复制此文件为 config.yaml
# 2. 填入你的钉钉机器人配置
# 3. 不要提交 config.yaml 到Git仓库（已加入.gitignore）

data_dir: data

# 钉钉机器人配置
# 1. 在钉钉群中添加自定义机器人
# 2. 复制 webhook URL 和加签密钥
# 3. 填入下方（去掉引号内的占位符）
dingtalk:
  webhook_url: "https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN_HERE"
  secret: "YOUR_SECRET_HERE"

# 飞书机器人配置
# 1. 在飞书群中添加自定义机器人，复制 webhook URL
# 2. 如机器人开启了"签名校验"，需同时填入加签密钥 secret
feishu:
  webhook_url: "https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx"
  secret: ""

# 企业微信机器人配置
# 在企业微信群中添加群机器人，复制 webhook URL（形如 key=xxx）
wecom:
  webhook_url: ""

# 定时任务配置
schedule:
  time: "17:00"  # 每日执行时间

# 数据更新配置
update:
  lookback_days: 10
  skip_failed: true
